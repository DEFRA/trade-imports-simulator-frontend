{#- Same params as govukSelect: `value` selects the matching item, or an item can set `selected`. -#}
{% from "macros/attributes.njk" import appAttributes %}
{% set id = params.id or params.name %}
{% set describedBy = params.describedBy or "" %}
<div class="app-field {{- ' app-field--error' if params.errorMessage }} {{- ' ' ~ params.formGroup.classes if params.formGroup.classes }}">
  {% if params.label %}
  <label class="app-field__label {{- ' ' ~ params.label.classes if params.label.classes }}" for="{{ id }}">
    {{- params.label.html | safe if params.label.html else params.label.text -}}
  </label>
  {% endif %}
  {% if params.hint %}
  {% set describedBy = describedBy ~ " " ~ id ~ "-hint" %}
  <div id="{{ id }}-hint" class="app-field__hint">{{ params.hint.html | safe if params.hint.html else params.hint.text }}</div>
  {% endif %}
  {% if params.errorMessage %}
  {% set describedBy = describedBy ~ " " ~ id ~ "-error" %}
  <p id="{{ id }}-error" class="app-field__error">{{ params.errorMessage.html | safe if params.errorMessage.html else params.errorMessage.text }}</p>
  {% endif %}
  <select class="app-select {{- ' app-input--error' if params.errorMessage }} {{- ' ' ~ params.classes if params.classes }}" id="{{ id }}" name="{{ params.name }}"
    {%- if describedBy | trim %} aria-describedby="{{ describedBy | trim }}"{% endif %}
    {%- if params.disabled %} disabled{% endif %}
    {{- appAttributes(params.attributes) }}>
    {% for item in params.items %}
    {% set itemValue = item.value if item.value is defined else item.text %}
    <option value="{{ itemValue }}"
      {%- if item.selected or (params.value is defined and params.value !== null and itemValue == params.value) %} selected{% endif %}
      {%- if item.disabled %} disabled{% endif %}>{{ item.text }}</option>
    {% endfor %}
  </select>
</div>
