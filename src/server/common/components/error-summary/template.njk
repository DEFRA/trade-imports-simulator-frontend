{#- Same params as govukErrorSummary. -#}
{% from "macros/attributes.njk" import appAttributes %}
<div class="app-error-summary {{- ' ' ~ params.classes if params.classes }}" role="alert" tabindex="-1" {{- appAttributes(params.attributes) }}>
  <strong class="app-error-summary__title">{{ params.titleHtml | safe if params.titleHtml else params.titleText | default('There is a problem') }}</strong>
  {% if params.descriptionHtml or params.descriptionText %}
  <p class="app-error-summary__description">{{ params.descriptionHtml | safe if params.descriptionHtml else params.descriptionText }}</p>
  {% endif %}
  {% if params.errorList | length %}
  <ul class="app-error-summary__list">
    {% for item in params.errorList %}
    <li>
      {% if item.href %}<a href="{{ item.href }}">{% endif %}
      {{- item.html | safe if item.html else item.text -}}
      {% if item.href %}</a>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
