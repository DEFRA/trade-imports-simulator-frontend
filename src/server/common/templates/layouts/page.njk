{% extends "layouts/base.njk" %}

{# Components imported for every page, as the template did for govuk ones. #}
{% from "breadcrumbs/macro.njk" import appBreadcrumbs %}
{% from "button/macro.njk" import appButton %}
{% from "card/macro.njk" import appCard %}
{% from "commodity-picker/macro.njk" import appCommodityPicker %}
{% from "error-summary/macro.njk" import appErrorSummary %}
{% from "heading/macro.njk" import appHeading %}
{% from "input/macro.njk" import appInput %}
{% from "pagination/macro.njk" import appPagination %}
{% from "radios/macro.njk" import appRadios %}
{% from "select/macro.njk" import appSelect %}
{% from "sub-navigation/macro.njk" import appSubNavigation %}
{% from "summary-list/macro.njk" import appSummaryList %}
{% from "table/macro.njk" import appTable %}
{% from "tag/macro.njk" import appTag %}

{% set serviceTitle = "Trade imports simulator" %}

{% block pageTitle %}
  {{ pageTitle }} | {{ serviceTitle }}
{% endblock %}

{% block headIcons %}
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23003078'/%3E%3C/svg%3E">
{% endblock %}

{% block head %}
  {# Client modules send this as X-CSRF-Token when they post JSON. #}
  <meta name="csrf-token" content="{{ crumb }}">
  <link href="{{ getAssetPath('src/client/stylesheets/application.scss') }}" rel="stylesheet">
{% endblock %}

{% block header %}
  <header class="app-header">
    <a class="app-header__title" href="{{ serviceUrl }}">{{ serviceTitle }}</a>
    <nav aria-label="Simulators">
      <ul class="app-header__nav">
        {% for item in navigation %}
        <li>
          <a class="app-header__link" href="{{ item.href }}" {%- if item.current %} aria-current="page"{% endif %}>{{ item.text }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </header>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ getAssetPath('src/client/javascripts/application.js') }}"></script>
{% endblock %}
