{% extends 'layouts/page.njk' %}

{% from "partials/traces/status-tag.njk" import statusTag %}
{% from "partials/traces/ched-links.njk" import chedLinks with context %}

{% block content %}
  {{ appHeading({
    text: "CHEDs",
    caption: "CHEDs created in the TRACES NT simulator from this browser session."
  }) }}

  <div class="app-toolbar">
    <span class="app-links">
      {{ appButton({ text: "Create a CHED", href: "/traces/cheds/new" }) }}
      <a href="/poc/simulator/ched/find" target="_blank" rel="noopener">Find CHEDs in the simulator</a>
    </span>
    <form class="app-toolbar__form" method="get" action="/traces/cheds">
      {{ appInput({ name: "id", label: { text: "Open a CHED by reference" }, spellcheck: false, classes: "app-input--reference" }) }}
      {{ appButton({ text: "Open", classes: "app-button--blue" }) }}
    </form>
  </div>

  {% call appCard() %}
    {% if cheds | length %}
      {% set rows = [] %}
      {% for ched in cheds %}
        {% if ched.missing %}
          {% set _ = rows.push([
            { html: '<span class="app-mono">' ~ ched.id ~ '</span>' },
            { text: "" },
            { html: appTag({ text: "Not in the simulator", classes: "app-tag--grey" }) },
            { text: "" }
          ]) %}
        {% else %}
          {% set _ = rows.push([
            { html: '<a href="/traces/cheds/' ~ ched.id ~ '" class="app-mono">' ~ ched.id ~ '</a>' },
            { text: "CHED-" ~ ched.type },
            { html: statusTag(ched.status) },
            { html: '<span class="app-links"><a href="/traces/cheds/' ~ ched.id ~ '/decision">Decision</a>' ~ chedLinks(ched.id) ~ '</span>' }
          ]) %}
        {% endif %}
      {% endfor %}
      {{ appTable({
        head: [{ text: "Reference" }, { text: "Type" }, { text: "Status" }, { html: '<span class="app-visually-hidden">Actions</span>' }],
        rows: rows
      }) }}
    {% else %}
      <p class="app-empty">None yet. CHEDs you create appear here.</p>
    {% endif %}
  {% endcall %}
{% endblock %}
