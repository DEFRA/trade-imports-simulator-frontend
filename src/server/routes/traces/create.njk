{% extends 'layouts/page.njk' %}

{% from "partials/traces/ched-header.njk" import chedParts %}

{% block content %}
  {{ appBreadcrumbs({ items: [{ text: "CHEDs", href: "/traces" }, { text: "Create a CHED" }] }) }}
  {{ appHeading({ text: "Create a CHED", caption: "Part I, the declaration. " ~ chedParts["I"] }) }}

  {# Step 1: choose a start. Choosing one hides this and shows step 2, the form, filled from it. #}
  <section class="app-start" id="ched-start" aria-labelledby="ched-start-title">
    <h2 class="app-start__title" id="ched-start-title">Start from</h2>
    <div class="app-start__options">
      <div class="app-start__option">
        <p class="app-field__label">A new blank CHED</p>
        <div class="app-start__buttons">
          {% for start in blankStarts %}
            {{ appButton({
              text: start.text,
              type: "button",
              classes: "app-button--choice",
              attributes: { "data-start": start.id }
            }) }}
          {% endfor %}
        </div>
      </div>
      <p class="app-start__or">or</p>
      <div class="app-start__option">
        {{ appSelect({
          name: "scenario",
          label: { text: "A scenario" },
          items: scenarioItems
        }) }}
      </div>
    </div>
  </section>
  <script type="application/json" id="start-models">{{ startModels | jsonIsland }}</script>

  <div id="ched-form-step" hidden>
  {% call appCard() %}
    {% set chedForm = {
      id: "create-ched",
      action: "/traces/api/cheds",
      done: "/traces/cheds/{id}?created=true",
      starts: "start-models",
      startPicker: "ched-start",
      step: "ched-form-step",
      scenarioAction: "/traces/api/scenarios",
      submitText: "Create CHED"
    } %}
    {% include "partials/traces/ched-form.njk" %}
  {% endcall %}
  </div>
{% endblock %}
