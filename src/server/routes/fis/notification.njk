{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appBreadcrumbs({ items: [{ text: "FIS", href: "/fis" }, { text: notification.reference }] }) }}

  <div class="app-title-row">
    <h1 class="app-mono app-ched-title">{{ notification.reference }}</h1>
    <span class="app-muted">Last updated {{ notification.lastUpdated | formatDate("d MMM yyyy HH:mm") }}</span>
  </div>

  {% if created or updated %}
    {% call appCard({ classes: "app-result" }) %}
      <p><strong>{{ "Created." if created else "Saved." }}</strong> The simulator published the notification to BTMS.</p>
    {% endcall %}
  {% endif %}

  {% call appCard() %}
    {{ appSummaryList({
      rows: [
        { key: { text: "IUU check outcome" }, value: { text: notification.iuuCheckOutcome or "None" } },
        { key: { text: "Last updated" }, value: { text: notification.lastUpdated | formatDate("d MMM yyyy HH:mm:ss") } }
      ]
    }) }}
  {% endcall %}

  {% call appCard({ title: { text: "Update" } }) %}
    {% set notificationForm = {
      method: "PUT",
      reference: notification.reference,
      iuuCheckOutcome: notification.iuuCheckOutcome,
      done: "/fis/notifications/{reference}?updated=true",
      submitText: "Save changes"
    } %}
    {% include "partials/fis/notification-form.njk" %}
  {% endcall %}

  {% include "partials/fis/message-preview.njk" %}

  {% call appCard({ title: { text: "Delete" } }) %}
    <p>Removes the notification from the simulator. Nothing is published to BTMS. You'll be asked to confirm.</p>
    <div class="app-button-row">
      {{ appButton({
        text: "Delete notification",
        href: "/fis/notifications/" ~ (notification.reference | urlencode) ~ "/delete",
        classes: "app-button--warning"
      }) }}
    </div>
  {% endcall %}
{% endblock %}
