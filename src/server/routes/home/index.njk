{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Stand-ins for the upstream systems that feed BTMS, for testing and demos."
  }) }}

  {% call appCard({ classes: "app-simulator-list" }) %}
    {% set rows = [] %}
    {% for simulator in simulators %}
      {% set rows = (rows.push([
        { html: '<a href="' + simulator.href + '">' + simulator.text + '</a>' } if simulator.enabled else { text: simulator.text },
        { text: simulator.description },
        { html: appTag({ text: "Enabled", classes: "app-tag--green" }) if simulator.enabled else appTag({ text: "Disabled", classes: "app-tag--grey" }) }
      ]), rows) %}
    {% endfor %}
    {{ appTable({
      head: [{ text: "System" }, { text: "What it does" }, { text: "Status" }],
      rows: rows
    }) }}
  {% endcall %}
{% endblock %}
