{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Stand-ins for the upstream systems that feed BTMS, for testing and demos."
  }) }}

  {% call appCard({ classes: "app-simulator-list" }) %}
    {{ appTable({
      head: [{ text: "System" }, { text: "What it does" }, { text: "Status" }],
      rows: [
        [
          { html: '<a href="/traces">TRACES</a>' },
          { text: "Create, update, accept and reject CHEDs in the TRACES NT simulator." },
          { html: appTag({ text: "In progress", classes: "app-tag--yellow" }) }
        ],
        [
          { text: "IPAFFS" },
          { text: "Not built yet." },
          { html: appTag({ text: "Planned", classes: "app-tag--grey" }) }
        ],
        [
          { text: "CDS" },
          { text: "Not built yet." },
          { html: appTag({ text: "Planned", classes: "app-tag--grey" }) }
        ]
      ]
    }) }}
  {% endcall %}
{% endblock %}
